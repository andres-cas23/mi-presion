# ============================================================
#  Copie este archivo con el nombre .env y llene los valores.
#  El archivo .env NUNCA se sube a GitHub (está en .gitignore).
# ============================================================

# --- Base de datos ---
# Déjelo vacío para usar SQLite local (un archivo en su computador).
# Para Supabase: Connect > "Session pooler" > copie la URI y ponga su contraseña.
# DATABASE_URL=postgresql://postgres.SU_REF:SU_CLAVE@aws-1-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# --- Seguridad ---
# Textos largos y aleatorios. Genérelos con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambie-esto-por-un-texto-largo-y-aleatorio
# Cifra los datos clínicos. ¡No la cambie después de tener datos guardados!
ENCRYPTION_KEY=

# --- Asistente con Gemini ---
# Consiga su llave gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.5-flash-lite
ASISTENTE_LIMITE_POR_HORA=20

# --- Quién puede usar la API ---
# "*" permite cualquier página. En producción: la URL de su frontend.
CORS_ORIGINS=*
